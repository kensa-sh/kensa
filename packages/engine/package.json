{
  "name": "kensa-engine",
  "version": "0.19.1",
  "type": "module",
  "bin": {
    "kensa-engine": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/clean-package-dist.mjs && esbuild src/cli.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/cli.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@kensa/core": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "@vitest/coverage-v8": "catalog:",
    "esbuild": "^0.27.0",
    "vitest": "catalog:"
  }
}
