{
  "name": "@kensa/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "schema:check": "tsx scripts/artifact-check.ts",
    "schema:generate": "tsx scripts/artifact-check.ts --write"
  },
  "dependencies": {
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "ajv": "^8.20.0",
    "tsx": "^4.20.3",
    "vitest": "^3.2.4"
  }
}
