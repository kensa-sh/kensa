{
  "name": "kensa",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:python-wheel": "node scripts/build-engine-wheel.mjs",
    "check:core-platform": "pnpm --filter @kensa/core check:platform",
    "format:check": "prettier --check \"packages/**/*.{ts,json}\" \"sdk/**/*.{ts,json}\" \"*.json\"",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
