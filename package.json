{
  "name": "kensa",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm --filter @kensa/core build",
    "format:check": "prettier --check \"packages/**/*.ts\" \"*.json\"",
    "lint": "eslint packages",
    "typecheck": "pnpm --filter @kensa/core typecheck",
    "test": "pnpm --filter @kensa/core test",
    "test:coverage": "pnpm --filter @kensa/core test:coverage",
    "schema:check": "pnpm --filter @kensa/core schema:check"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@typescript-eslint/parser": "^8.38.0",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@types/node": "^24.0.10",
    "eslint": "^9.31.0",
    "prettier": "^3.6.2",
    "typescript": "^6.0.0",
    "vitest": "^3.2.4"
  }
}
