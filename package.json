{
  "name": "kensa",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "build": "pnpm -r build && node scripts/generate-build-manifest.mjs",
    "build:python-wheel": "node scripts/build-engine-wheel.mjs",
    "check:core-platform": "pnpm --filter @kensa/core check:platform",
    "format:check": "prettier --check \"packages/**/*.{ts,json}\" \"sdk/typescript/**/*.{ts,json}\" \"*.json\"",
    "test": "pnpm -r test && pnpm test:release",
    "test:coverage": "pnpm -r test:coverage && pnpm test:release:coverage",
    "test:release": "vitest run --config vitest.release.config.ts",
    "test:release:coverage": "vitest run --config vitest.release.config.ts --coverage",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "@vitest/coverage-v8": "catalog:",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vitest": "catalog:"
  }
}
