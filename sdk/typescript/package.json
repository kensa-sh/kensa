{
  "name": "@kensa/sdk",
  "version": "0.19.1",
  "description": "TypeScript and Vitest authoring SDK for Kensa evaluations",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kensa-sh/kensa.git",
    "directory": "sdk/typescript"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vitest": {
      "types": "./dist/vitest.d.ts",
      "import": "./dist/vitest.js"
    },
    "./build-manifest.json": "./dist/build-manifest.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node ../../scripts/clean-package-dist.mjs && tsc -p tsconfig.build.json",
    "prepack": "node ../../scripts/generate-build-manifest.mjs --output sdk/typescript/dist/build-manifest.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@kensa/core": "workspace:*",
    "yaml": "catalog:"
  },
  "peerDependencies": {
    "vitest": "^4.1.6"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vitest/coverage-v8": "catalog:",
    "vitest": "catalog:"
  }
}
