{
  "$defs": {
    "EvalRunDocumentKind": {
      "enum": [
        "eval_run"
      ],
      "type": "string"
    },
    "EvalRunId": {
      "pattern": "^run_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "EvalRunStatus": {
      "enum": [
        "pending",
        "running",
        "pass",
        "fail",
        "error",
        "cancelled",
        "interrupted"
      ],
      "type": "string"
    },
    "Failure": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "$ref": "#/$defs/FailureCategory"
        },
        "evidence": {
          "additionalProperties": true,
          "type": "object"
        },
        "kind": {
          "$ref": "#/$defs/NonBlankString"
        },
        "message": {
          "$ref": "#/$defs/NonBlankString"
        }
      },
      "required": [
        "category",
        "evidence",
        "kind",
        "message"
      ],
      "type": "object"
    },
    "FailureCategory": {
      "enum": [
        "agent",
        "simulator",
        "judge",
        "configuration",
        "infrastructure",
        "harness",
        "unknown"
      ],
      "type": "string"
    },
    "NonBlankString": {
      "pattern": "\\S",
      "type": "string"
    },
    "SchemaVersion": {
      "enum": [
        "kensa.protocol.v1"
      ],
      "type": "string"
    },
    "Timestamp": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attributes": {
      "additionalProperties": true,
      "type": "object"
    },
    "created_at": {
      "$ref": "#/$defs/Timestamp"
    },
    "document_kind": {
      "$ref": "#/$defs/EvalRunDocumentKind"
    },
    "duration_ms": {
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "ended_at": {
      "anyOf": [
        {
          "$ref": "#/$defs/Timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "failure": {
      "anyOf": [
        {
          "$ref": "#/$defs/Failure"
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "$ref": "#/$defs/EvalRunId"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion"
    },
    "started_at": {
      "anyOf": [
        {
          "$ref": "#/$defs/Timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "$ref": "#/$defs/EvalRunStatus"
    }
  },
  "required": [
    "attributes",
    "created_at",
    "document_kind",
    "duration_ms",
    "ended_at",
    "failure",
    "id",
    "schema_version",
    "started_at",
    "status"
  ],
  "title": "EvalRun",
  "type": "object"
}
