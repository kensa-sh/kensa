        {
          "type": "null"
        }
      ]
    },
    "__schema16": {
      "type": "boolean"
    },
    "__schema17": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema5"
        },
        {
          "type": "null"
        }
      ]
