                "simulator",
                "judge",
                "configuration",
                "infrastructure",
                "harness",
                "unknown"
              ]
            },
            "kind": {
              "$ref": "#/$defs/__schema19"
            },
            "message": {
              "$ref": "#/$defs/__schema19"
            },
            "evidence": {
              "$ref": "#/$defs/__schema7"
            }
          },
          "required": ["category", "kind", "message", "evidence"],
          "additionalProperties": false
