{
  "$defs": {
    "CaseId": {
      "pattern": "\\S",
      "type": "string"
    },
    "CaseSnapshot": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/CaseId"
        },
        "input": true,
        "metadata": {
          "additionalProperties": true,
          "type": "object"
        }
      },
      "required": [
        "id",
        "input",
        "metadata"
      ],
      "type": "object"
    },
    "EffectPolicy": {
      "enum": [
        "none",
        "captured",
        "sandboxed",
        "live"
      ],
      "type": "string"
    },
    "EvalRunId": {
      "pattern": "^run_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "EvidenceCompleteness": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/NonBlankString"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/$defs/EvidenceStatus"
        }
      },
      "required": [
        "reason",
        "status"
      ],
      "type": "object"
    },
    "EvidenceStatus": {
      "enum": [
        "complete",
        "pending",
        "partial",
        "unavailable"
      ],
      "type": "string"
    },
    "ExecutionProvenance": {
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "anyOf": [
            {
              "$ref": "#/$defs/NonBlankString"
            },
            {
              "type": "null"
            }
          ]
        },
        "adapter_version": {
          "anyOf": [
            {
              "$ref": "#/$defs/NonBlankString"
            },
            {
              "type": "null"
            }
          ]
        },
        "effects": {
          "$ref": "#/$defs/EffectPolicy"
        },
        "environment": {
          "anyOf": [
            {
              "$ref": "#/$defs/NonBlankString"
            },
            {
              "type": "null"
            }
          ]
        },
        "producer": {
          "$ref": "#/$defs/NonBlankString"
        },
        "producer_version": {
          "$ref": "#/$defs/NonBlankString"
        },
        "revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/NonBlankString"
            },
            {
              "type": "null"
            }
          ]
        },
        "runtime": {
          "$ref": "#/$defs/NonBlankString"
        },
        "runtime_version": {
          "$ref": "#/$defs/NonBlankString"
        }
      },
      "required": [
        "adapter",
        "adapter_version",
        "effects",
        "environment",
        "producer",
        "producer_version",
        "revision",
        "runtime",
        "runtime_version"
      ],
      "type": "object"
    },
    "Failure": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "$ref": "#/$defs/FailureCategory"
        },
        "evidence": {
          "additionalProperties": true,
          "type": "object"
        },
        "kind": {
          "$ref": "#/$defs/NonBlankString"
        },
        "message": {
          "$ref": "#/$defs/NonBlankString"
        }
      },
      "required": [
        "category",
        "evidence",
        "kind",
        "message"
      ],
      "type": "object"
    },
    "FailureCategory": {
      "enum": [
        "agent",
        "simulator",
        "judge",
        "configuration",
        "infrastructure",
        "harness",
        "unknown"
      ],
      "type": "string"
    },
    "InvocationDocumentKind": {
      "enum": [
        "invocation"
      ],
      "type": "string"
    },
    "InvocationId": {
      "pattern": "^inv_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "InvocationStatus": {
      "enum": [
        "pending",
        "running",
        "pass",
        "fail",
        "error",
        "cancelled",
        "skipped",
        "interrupted"
      ],
      "type": "string"
    },
    "NonBlankString": {
      "pattern": "\\S",
      "type": "string"
    },
    "SchemaVersion": {
      "enum": [
        "kensa.protocol.v1"
      ],
      "type": "string"
    },
    "Timestamp": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempt": {
      "format": "uint32",
      "minimum": 1,
      "type": "integer"
    },
    "attributes": {
      "additionalProperties": true,
      "type": "object"
    },
    "case": {
      "$ref": "#/$defs/CaseSnapshot"
    },
    "document_kind": {
      "$ref": "#/$defs/InvocationDocumentKind"
    },
    "duration_ms": {
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "ended_at": {
      "anyOf": [
        {
          "$ref": "#/$defs/Timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_completeness": {
      "$ref": "#/$defs/EvidenceCompleteness"
    },
    "failure": {
      "anyOf": [
        {
          "$ref": "#/$defs/Failure"
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "$ref": "#/$defs/InvocationId"
    },
    "output": true,
    "output_recorded": {
      "type": "boolean"
    },
    "provenance": {
      "$ref": "#/$defs/ExecutionProvenance"
    },
    "run_id": {
      "$ref": "#/$defs/EvalRunId"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion"
    },
    "started_at": {
      "anyOf": [
        {
          "$ref": "#/$defs/Timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "$ref": "#/$defs/InvocationStatus"
    }
  },
  "required": [
    "attempt",
    "attributes",
    "case",
    "document_kind",
    "duration_ms",
    "ended_at",
    "evidence_completeness",
    "failure",
    "id",
    "output",
    "output_recorded",
    "provenance",
    "run_id",
    "schema_version",
    "started_at",
    "status"
  ],
  "title": "Invocation",
  "type": "object"
}
