          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema6"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema6"
          }
        }
      ]
    },
    "__schema7": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/__schema8"
      },
      "additionalProperties": {
        "$ref": "#/$defs/__schema9"
      }
    },
    "__schema8": {
      "type": "string"
    },
    "__schema9": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema9"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema9"
          }
        }
      ]
    },
    "__schema10": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
