    "__schema13": {
      "type": "string"
    },
    "__schema14": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema13"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema15": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
